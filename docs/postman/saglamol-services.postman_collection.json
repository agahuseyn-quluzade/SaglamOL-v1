            { "name": "User insurance scope", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{profile_url}}/internal/v1/users/{{iam_user_id}}/insurance-scope" } },
            { "name": "User profile summary", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{profile_url}}/internal/v1/profiles/users/{{iam_user_id}}/summary" } }

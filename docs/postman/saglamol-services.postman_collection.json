              }
            },
            { "name": "Submit claim", "request": { "method": "POST", "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/submit" } },
            { "name": "Get claim", "request": { "method": "GET", "url": "{{claim_url}}/api/v1/claims/{{claim_id}}" } },
            { "name": "My claims", "request": { "method": "GET", "url": "{{claim_url}}/api/v1/claims/my?page=0&size=20" } },
            { "name": "Search claims", "request": { "method": "GET", "url": "{{claim_url}}/api/v1/claims?companyId={{company_id}}&status=SUBMITTED&page=0&size=20" } }
          ]
        },
        {
          "name": "Review",
          "item": [
            { "name": "Start review", "request": { "method": "POST", "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/review/start" } },
            { "name": "Request more documents", "request": { "method": "POST", "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/review/more-documents?reason=Missing%20invoice" } },
            {
              "name": "Approve claim",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/review/approve",
                "body": { "mode": "raw", "raw": "{\n  \"note\": \"Approved for payment\"\n}" }
              }
            },
            {
              "name": "Reject claim",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/review/reject",
                "body": { "mode": "raw", "raw": "{\n  \"note\": \"Rejected for test\"\n}" }
              }
            },
            { "name": "Cancel claim", "request": { "method": "PUT", "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/review/cancel?reason=test" } }
          ]
        },
        {
          "name": "Internal",
          "item": [
            { "name": "Internal get claim", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{claim_url}}/internal/v1/claims/{{claim_id}}" } },
            { "name": "Internal claim summary", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{claim_url}}/internal/v1/claims/{{claim_id}}/summary" } },
            { "name": "Internal by patient", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{claim_url}}/internal/v1/claims/by-patient/{{patient_profile_id}}/summary?page=0&size=20" } }
          ]
        }
      ]
    },
    {
      "name": "Health Record Service",
      "item": [
        {
          "name": "Health Records",
          "item": [
            {
              "name": "Create health record",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{health_url}}/api/v1/health-records",
                "body": { "mode": "raw", "raw": "{\n  \"patientProfileId\": \"{{patient_profile_id}}\",\n  \"doctorProfileId\": \"{{doctor_profile_id}}\",\n  \"hospitalId\": \"{{hospital_id}}\",\n  \"claimId\": \"{{claim_id}}\",\n  \"diagnosis\": \"Test diagnosis\"\n}" }
              }
            },
            { "name": "My health records", "request": { "method": "GET", "url": "{{health_url}}/api/v1/health-records/my?page=0&size=20" } },
            { "name": "Get health record", "request": { "method": "GET", "url": "{{health_url}}/api/v1/health-records/{{health_record_id}}" } },
            { "name": "Health records by claim", "request": { "method": "GET", "url": "{{health_url}}/api/v1/health-records/by-claim/{{claim_id}}?page=0&size=20" } },
            {
              "name": "Add treatment",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{health_url}}/api/v1/health-records/{{health_record_id}}/treatments",
                "body": { "mode": "raw", "raw": "{\n  \"description\": \"Consultation\",\n  \"treatmentDate\": \"2026-01-15\"\n}" }
              }
            },
            { "name": "Archive health record", "request": { "method": "PATCH", "url": "{{health_url}}/api/v1/health-records/{{health_record_id}}/archive" } }
          ]
        },
        {
          "name": "Documents",
          "item": [
            {
              "name": "Initiate upload",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{health_url}}/api/v1/health-records/{{health_record_id}}/documents/uploads",
                "body": { "mode": "raw", "raw": "{\n  \"fileName\": \"invoice.pdf\",\n  \"contentType\": \"application/pdf\",\n  \"sizeBytes\": 1024\n}" }
              }
            },
            {
              "name": "Confirm upload",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{health_url}}/api/v1/health-records/{{health_record_id}}/documents/{{document_id}}/confirm",
                "body": { "mode": "raw", "raw": "{\n  \"sha256Hash\": \"replace-with-sha256\"\n}" }
              }
            },
            { "name": "Get document", "request": { "method": "GET", "url": "{{health_url}}/api/v1/health-records/{{health_record_id}}/documents/{{document_id}}" } },
            { "name": "Delete document", "request": { "method": "DELETE", "url": "{{health_url}}/api/v1/health-records/{{health_record_id}}/documents/{{document_id}}" } }
          ]
        },
        {
          "name": "Internal",
          "item": [
            {
              "name": "Document hash batch",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }],
                "url": "{{health_url}}/internal/v1/documents/hash/batch",
                "body": { "mode": "raw", "raw": "{\n  \"documentIds\": [\"{{document_id}}\"]\n}" }
              }
            },
            { "name": "Document hash", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{health_url}}/internal/v1/health-records/documents/{{document_id}}/hash" } },
            { "name": "Documents by claim", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{health_url}}/internal/v1/health-records/documents/by-claim/{{claim_id}}" } }
          ]
        }
      ]
    },

    {
      "name": "Policy Service",
      "item": [
        {
          "name": "Products",
          "item": [
            {
              "name": "Create product",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{policy_url}}/api/v1/insurance-products",
                "body": { "mode": "raw", "raw": "{\n  \"companyId\": \"{{company_id}}\",\n  \"name\": \"Basic Health\",\n  \"description\": \"Basic health insurance\"\n}" }
              }
            },
            { "name": "List products", "request": { "method": "GET", "url": "{{policy_url}}/api/v1/insurance-products?companyId={{company_id}}&page=0&size=20" } },
            { "name": "Get product", "request": { "method": "GET", "url": "{{policy_url}}/api/v1/insurance-products/{{product_id}}" } },
            { "name": "Change product status", "request": { "method": "PATCH", "url": "{{policy_url}}/api/v1/insurance-products/{{product_id}}/status?newStatus=ACTIVE" } }
          ]
        },
        {
          "name": "Coverage Rules",
          "item": [
            {
              "name": "Create coverage rule",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{policy_url}}/api/v1/insurance-products/{{product_id}}/coverage-rules",
                "body": { "mode": "raw", "raw": "{\n  \"coverageType\": \"GENERAL\",\n  \"annualLimit\": 1000,\n  \"copayPercent\": 10\n}" }
              }
            },
            { "name": "List coverage rules", "request": { "method": "GET", "url": "{{policy_url}}/api/v1/insurance-products/{{product_id}}/coverage-rules?page=0&size=20" } },
            { "name": "Change coverage rule status", "request": { "method": "PATCH", "url": "{{policy_url}}/api/v1/insurance-products/{{product_id}}/coverage-rules/{{rule_id}}/status?newStatus=ACTIVE" } }
          ]
        },
        {
          "name": "Policies",
          "item": [
            {
              "name": "Issue policy",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{policy_url}}/api/v1/policies",
                "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"patientProfileId\": \"{{patient_profile_id}}\",\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-12-31\"\n}" }
              }
            },
            { "name": "Get policy", "request": { "method": "GET", "url": "{{policy_url}}/api/v1/policies/{{policy_id}}" } },
            { "name": "My policies", "request": { "method": "GET", "url": "{{policy_url}}/api/v1/policies/me?page=0&size=20" } },
            { "name": "Search policies", "request": { "method": "GET", "url": "{{policy_url}}/api/v1/policies?companyId={{company_id}}&page=0&size=20" } },
            {
              "name": "Eligibility check",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{policy_url}}/api/v1/policies/eligibility-check",
                "body": { "mode": "raw", "raw": "{\n  \"policyId\": \"{{policy_id}}\",\n  \"patientProfileId\": \"{{patient_profile_id}}\",\n  \"coverageType\": \"GENERAL\",\n  \"amount\": 100\n}" }
              }
            },
            { "name": "Cancel policy", "request": { "method": "PATCH", "url": "{{policy_url}}/api/v1/policies/{{policy_id}}/cancel?reason=test" } },
            { "name": "Suspend policy", "request": { "method": "PATCH", "url": "{{policy_url}}/api/v1/policies/{{policy_id}}/suspend?reason=test" } }
          ]
        },

  "item": [
    {
      "name": "IAM Service",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Register patient user",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/register",
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@saglamol.az\",\n  \"phoneNumber\": \"+994501112233\",\n  \"password\": \"Patient123!\"\n}" }
              }
            },
            {
              "name": "Login by email",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/login/email",
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@saglamol.az\",\n  \"password\": \"Admin123!\"\n}" }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "pm.collectionVariables.set('access_token', json.accessToken || json.token || '');",
                      "pm.collectionVariables.set('refresh_token', json.refreshToken || '');"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Login by phone",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/login/phone",
                "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"+994501112233\",\n  \"password\": \"Patient123!\"\n}" }
              }
            },
            {
              "name": "Refresh token",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/refresh",
                "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" }
              }
            },
            {
              "name": "Current user",
              "request": { "method": "GET", "url": "{{iam_url}}/api/v1/iam/me" }
            }
          ]
        },
        {
          "name": "Password",
          "item": [
            {
              "name": "Change password",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/password/change",
                "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Old123!\",\n  \"newPassword\": \"New123!\"\n}" }
              }
            },
            {
              "name": "Request password reset",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/password/reset-request",
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@saglamol.az\"\n}" }
              }
            },
            {
              "name": "Confirm password reset",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/password/reset-confirm",
                "body": { "mode": "raw", "raw": "{\n  \"token\": \"reset-token\",\n  \"newPassword\": \"Patient123!\"\n}" }
              }
            }
          ]
        },
        {
          "name": "Users",
          "item": [
            { "name": "List users", "request": { "method": "GET", "url": "{{iam_url}}/api/v1/iam/users?page=0&size=20" } },
            { "name": "Get user", "request": { "method": "GET", "url": "{{iam_url}}/api/v1/iam/users/{{iam_user_id}}" } },
            { "name": "Search users", "request": { "method": "GET", "url": "{{iam_url}}/api/v1/iam/users/search?query=admin" } },
            {
              "name": "Change user status",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/users/{{iam_user_id}}/status",
                "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" }
              }
            },
            {
              "name": "Assign role",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{iam_url}}/api/v1/iam/users/{{iam_user_id}}/roles",
                "body": { "mode": "raw", "raw": "{\n  \"roleName\": \"AGENT\"\n}" }
              }
            },
            { "name": "Remove role", "request": { "method": "DELETE", "url": "{{iam_url}}/api/v1/iam/users/{{iam_user_id}}/roles/AGENT" } }
          ]
        }
      ]
    },

          ]
        },
        {
          "name": "Internal",
          "item": [
            { "name": "Internal get policy", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{policy_url}}/internal/v1/policies/{{policy_id}}" } },
            { "name": "Internal active policy", "request": { "method": "GET", "header": [{ "key": "X-Internal-Service-Secret", "value": "{{internal_service_secret}}" }], "url": "{{policy_url}}/internal/v1/policies/{{policy_id}}/active" } },

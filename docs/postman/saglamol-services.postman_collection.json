    {
      "name": "Claim Service",
      "item": [
        {
          "name": "Claims",
          "item": [
            {
              "name": "Create draft claim",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{claim_url}}/api/v1/claims",
                "body": { "mode": "raw", "raw": "{\n  \"policyId\": \"{{policy_id}}\",\n  \"patientProfileId\": \"{{patient_profile_id}}\",\n  \"hospitalId\": \"{{hospital_id}}\",\n  \"serviceDate\": \"2026-01-15\"\n}" }
              }
            },
            {
              "name": "Add claim item",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/items",
                "body": { "mode": "raw", "raw": "{\n  \"description\": \"Consultation\",\n  \"amount\": 100,\n  \"coverageType\": \"GENERAL\"\n}" }
              }
            },
            {
              "name": "Attach document",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{claim_url}}/api/v1/claims/{{claim_id}}/documents",

            { "name": "Mark invoice paid", "request": { "method": "POST", "url": "{{payment_url}}/api/v1/invoices/{{invoice_id}}/mark-paid" } },
            { "name": "Cancel invoice", "request": { "method": "POST", "url": "{{payment_url}}/api/v1/invoices/{{invoice_id}}/cancel" } }
